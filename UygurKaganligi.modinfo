<?xml version="1.0" encoding="utf-8"?>
<Mod id="8fe8436a-c148-46de-a6df-fc488d4e9c56" version="4">
  <Properties>
    <Name>Uyghur Khaganate</Name>
    <Description>Adds the Uyghur Khaganate under Bogu Khagan, with the Yaglakar Horseman, Bitig Evi, distinctive blue and gold colors, and 2D leader artwork. Requires Gathering Storm.</Description>
    <Created>1792872971</Created>
    <Teaser>Lead the Uyghur Khaganate under Bogu Khagan!</Teaser>
    <Authors>saosao</Authors>
    <CompatibleVersions>1.2,2.0</CompatibleVersions>
  </Properties>
  <FrontEndActions>
    <UpdateColors id="Uygur_FrontEnd_Colors">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Colors.xml</File>
    </UpdateColors>
    <UpdateDatabase id="Uygur_FrontEnd_Database">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Core.sql</File>
      <File>Data/Uygur_Config.sql</File>
    </UpdateDatabase>
    <UpdateText id="Uygur_FrontEnd_Text">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Text/Uygur_Text.xml</File>
    </UpdateText>
    <UpdateIcons id="Uygur_FrontEnd_Icons">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Icons.xml</File>
    </UpdateIcons>
    <ImportFiles id="Uygur_FrontEnd_Import">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Diplomacy_BG.dds</File>
    </ImportFiles>
    <UpdateArt id="Uygur_FrontEnd_Art">
      <File>UygurKaganligi.dep</File>
    </UpdateArt>
  </FrontEndActions>
  <InGameActions>
    <UpdateColors id="Uygur_InGame_Colors">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Colors.xml</File>
    </UpdateColors>
    <UpdateDatabase id="Uygur_InGame_Database">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Core.sql</File>
      <File>Data/Uygur_Gameplay.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="Uygur_InGame_Trade">
      <Properties>
        <LoadOrder>20001</LoadOrder>
      </Properties>
      <File>Data/Uygur_Trade.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="Uygur_InGame_Tolerance">
      <Properties>
        <LoadOrder>20002</LoadOrder>
      </Properties>
      <File>Data/Uygur_Tolerance.sql</File>
    </UpdateDatabase>
    <AddGameplayScripts id="Uygur_InGame_Tolerance_Script">
      <Properties>
        <LoadOrder>20002</LoadOrder>
      </Properties>
      <File>Scripts/Uygur_Tolerance.lua</File>
    </AddGameplayScripts>
    <UpdateText id="Uygur_InGame_Text">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Text/Uygur_Text.xml</File>
    </UpdateText>
    <UpdateIcons id="Uygur_InGame_Icons">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Icons.xml</File>
    </UpdateIcons>
    <ImportFiles id="Uygur_InGame_Import">
      <Properties>
        <LoadOrder>20000</LoadOrder>
      </Properties>
      <File>Data/Uygur_Diplomacy_BG.dds</File>
    </ImportFiles>
    <UpdateArt id="Uygur_InGame_Art">
      <File>UygurKaganligi.dep</File>
    </UpdateArt>
  </InGameActions>
